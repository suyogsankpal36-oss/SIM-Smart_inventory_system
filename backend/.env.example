# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database engine: "mysql" (default) or "sqlite" (quick local dev, no MySQL needed)
DB_ENGINE=mysql
DB_NAME=smart_business_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# JWT
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS - comma separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiting & Throttles
THROTTLE_RATE_ANON=120/minute
THROTTLE_RATE_USER=1200/minute
THROTTLE_RATE_AUTH_IP=15/minute
THROTTLE_RATE_AUTH_ACCOUNT=8/minute

# Auth Progressive Exponential Backoff
AUTH_MAX_FREE_ATTEMPTS=3
AUTH_INITIAL_BACKOFF_SEC=15
AUTH_MAX_BACKOFF_SEC=900

# Production Security & SSL (set for production deployment)
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True


